# Copy to .env and adjust. `.env` is git-ignored.
# It is read by BOTH Docker Compose (${VAR} interpolation) and Spring Boot
# (spring.config.import=optional:file:.env[.properties]).
#
# Everything has a sane default in application*.yml, so the app runs WITHOUT a .env.
# Use this only to override (real Gemini key, custom ports, etc.).

# Database (compose + app)
DB_NAME=reqsai
DB_USERNAME=reqsai
DB_PASSWORD=secret
DB_PORT=5432

# Mailpit — local dev email
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# App
SERVER_PORT=8080
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:4200

# AI (optional — leave empty to run without AI features)
GEMINI_API_KEY=

# JWT (dev keys come from scripts/generate-jwt-keys.sh)
JWT_ISSUER=reqsai
