# Copy to .env and adjust. `.env` is git-ignored.
# It is read by BOTH Docker Compose (${VAR} interpolation) and Spring Boot
# (spring.config.import=optional:file:.env[.properties]).
#
# Everything has a sane default in application*.yml, so the app runs WITHOUT a .env.
# Use this file to activate AI providers, override ports, supply secrets, etc.

# ── Database (compose + app) ──────────────────────────────────────────────────
DB_NAME=reqsai
DB_USERNAME=reqsai
DB_PASSWORD=secret
DB_PORT=5432

# ── Mailpit — local dev email ──────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── Email provider ─────────────────────────────────────────────────────────────
# Default is mailpit (local Docker) — no credentials needed.
# Uncomment ONE block below to switch provider.

# EMAIL_PROVIDER=mailpit   (default — runs automatically with Docker Compose)

# Mailtrap sandbox — https://mailtrap.io → Inboxes → SMTP Settings
# EMAIL_PROVIDER=mailtrap
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=<your-mailtrap-inbox-username>
# MAIL_PASSWORD=<your-mailtrap-inbox-password>
# MAIL_FROM=noreply@reqsai.com

# Gmail — requires a Google App Password (not your login password).
# Enable 2FA → Google Account → Security → App Passwords → generate one.
# EMAIL_PROVIDER=gmail
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx   # 16-char Google App Password
# MAIL_FROM=you@gmail.com

# ── App ────────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── JWT (dev keys come from scripts/generate-jwt-keys.sh) ─────────────────────
JWT_ISSUER=reqsai

# ══════════════════════════════════════════════════════════════════════════════
# AI providers — uncomment the section(s) you want to use.
# Each section sets:
#   SPRING_AI_MODEL_*   → activates the Spring AI bean for that capability
#   *_PROVIDER          → tells the reqsai router which adapter to call
#   provider key/URL    → credentials / location of the model server
#
# AI is OFF by default (spring.ai.model.* defaults to 'none' in application.yml).
# ══════════════════════════════════════════════════════════════════════════════

# ── Gemini (cloud) — generation + embeddings ──────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here
# SPRING_AI_MODEL_CHAT=google-genai
# SPRING_AI_MODEL_EMBEDDING=google-genai
# GENERATION_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini

# ── OpenAI (cloud) — generation + embeddings ──────────────────────────────────
# OPENAI_API_KEY=sk-...
# SPRING_AI_MODEL_CHAT=openai
# SPRING_AI_MODEL_EMBEDDING=openai
# GENERATION_PROVIDER=openai
# EMBEDDING_PROVIDER=openai

# ── Ollama (local, free) — generation + embeddings ────────────────────────────
# Run: ollama serve && ollama pull llama3.1:8b && ollama pull nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.1:8b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# SPRING_AI_MODEL_CHAT=ollama
# SPRING_AI_MODEL_EMBEDDING=ollama
# GENERATION_PROVIDER=gemini      # reqsai routes ollama through the generic ChatModel adapter
# EMBEDDING_PROVIDER=auto

# ── Whisper (local BATCH STT) ─────────────────────────────────────────────────
# Run: docker compose --profile core --profile ai up -d
# WHISPER_PORT=9000
# WHISPER_BASE_URL=http://localhost:9000/v1
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=auto
# WHISPER_DIARIZATION=false
# SPRING_AI_MODEL_AUDIO_TRANSCRIPTION=openai
# STT_PROVIDER=whisper

# ── WhisperLive (self-hosted STREAMING STT) ───────────────────────────────────
# WHISPERLIVE_URL=ws://localhost:9090
# STT_STREAMING_PROVIDER=whisperlive

# ── AssemblyAI (cloud STT — batch + streaming) ────────────────────────────────
# ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here
# STT_PROVIDER=assemblyai
# STT_STREAMING_PROVIDER=assemblyai

# ── Deepgram (cloud STT — batch + streaming) ──────────────────────────────────
# DEEPGRAM_API_KEY=your-deepgram-api-key-here
# DEEPGRAM_MODEL=nova-2
# STT_PROVIDER=deepgram
# STT_STREAMING_PROVIDER=deepgram
