# Copy to .env and adjust. `.env` is git-ignored.
# It is read by BOTH Docker Compose (${VAR} interpolation) and Spring Boot
# (spring.config.import=optional:file:.env[.properties]).
#
# Everything has a sane default in application*.yml, so the app runs WITHOUT a .env.
# Use this only to override (real Gemini key, custom ports, etc.).

# Database (compose + app)
DB_NAME=reqsai
DB_USERNAME=reqsai
DB_PASSWORD=secret
DB_PORT=5432

# Mailpit — local dev email
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# App
SERVER_PORT=8080
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:4200

# AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GEMINI_API_KEY=

# Whisper STT
WHISPER_PORT=9000
WHISPER_BASE_URL=http://localhost:9000/v1
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
WHISPER_DIARIZATION=false

# JWT (dev keys come from scripts/generate-jwt-keys.sh)
JWT_ISSUER=reqsai
